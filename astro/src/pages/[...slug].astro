---
import type { GetStaticPaths } from 'astro'

export const prerender = !(import.meta.env.MODE === 'development')

const getStaticPaths = prerender
    ? ((async () => {
          const response = await fetch(
              'http://payload:3000/api/pages?depth=0&draft=false&trash=false'
          )
          const data = await response.json()
          const pages = data.docs.map((page: any) => {
              return {
                  params: { slug: page.url },
                  props: {
                      title: page.title as string,
                      content: page.content as any,
                  },
              }
          })
          return pages
      }) satisfies GetStaticPaths)
    : undefined

export { getStaticPaths }

const { slug } = Astro.params

const url =
    'http://payload:3000/api/pages?depth=0&draft=false&trash=false' +
    '&where[url][equals]=' +
    encodeURIComponent(`/${slug}`)
const response = await fetch(url)
const data = await response.json()

console.log(url)
console.log(data)

const title = prerender ? Astro.props['title'] : data.docs[0].title + '!!!'
---

<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
    </head>
    <body>
        <h1>{title}</h1>
        <p>{title}</p>
    </body>
</html>
